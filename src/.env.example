# An example of a file with environment variables. Insert your values and rename this file to .env
DEBUG=True
USE_REDIS_SOCKET=False
USE_WEBHOOK=False
USE_POSTGRES_SOCKET=False

BOT_TOKEN=
ADMIN_IDS=

# OpenWeatherMap API key
WEATHER_API_TOKEN=

# Postgres
POSTGRES_DB_NAME=
POSTGRES_DB_USER=
POSTGRES_DB_PASS=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SOCKET_PATH=

# Redis (REDIS_DB_USER is optional - empty means the 'default' user)
REDIS_DB_INDEX=
REDIS_DB_USER=
REDIS_DB_PASS=
REDIS_HOST=
REDIS_PORT=
REDIS_SOCKET_PATH=

# Webhook, optional - defaults to long polling if USE_WEBHOOK is not true
WEBHOOK_HOST=
WEBHOOK_PATH=
WEBHOOK_TOKEN=
WEBAPP_HOST=
WEBAPP_PORT=
